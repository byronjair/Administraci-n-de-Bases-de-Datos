/*Seleccionar cuáles productos pertenecen a cada categoría */

create view vista_productos_categorias
as
select
    cast(c.nombre as varchar(100)) as categoria,
    p.id_producto,
    cast(p.nombre as varchar(100)) as producto,
    p.precio,
    p.stock
from categoria c
inner join producto p
    on c.id_categoria = p.id_categoria
where cast(c.nombre as varchar(100)) in (
    'Falda',
    'Pantalón',
    'Chamarra',
    'Zapato',
    'Accesorios'
);

select *from vista_productos_categorias
order by categoria, producto;
/* Seleccionar los encargados de las sucursales de la tienda Akira’s Boutique*/

create view vista_encargados_sucursales
as
select
    s.id_sucursal,
    s.nombre_sucursal,
    e.id_empleado,
    cast(e.nombre as varchar(100)) as nombre,
    cast(e.apellido_paterno as varchar(100)) as apellido_paterno,
    cast(e.apellido_materno as varchar(100)) as apellido_materno
from sucursales s
inner join empleados e
    on s.id_empleado = e.id_empleado;


select *from vista_encargados_sucursales;

/*  Seleccionar los empleados que trabajan en la sucursal de Akira’s Boutique: Constitución */
create view vista_empleados_constitucion
as
select
    e.id_empleado,
    cast(e.nombre as varchar(100)) as nombre,
    cast(e.apellido_paterno as varchar(100)) as apellido_paterno,
    cast(e.apellido_materno as varchar(100)) as apellido_materno,
    e.telefono,
    e.correo_electronico
from empleados e
inner join sucursales s
    on e.id_sucursal = s.id_sucursal
where s.nombre_sucursal like '%constitución%';


select *from vista_empleados_constitucion;


/* ¿Qué clientes son mayores de 30 años?*/
create view vista_clientes_mayores_30
as
select
    id_cliente,
    cast(nombre as varchar(100)) as nombre,
    cast(apellido as varchar(100)) as apellido,
    fec_nac,
    datediff(year, fec_nac, getdate())
    -
    case
        when dateadd(
            year,
            datediff(year, fec_nac, getdate()),
            fec_nac
        ) > getdate()
        then 1
        else 0
    end as edad
from cliente
where
    datediff(year, fec_nac, getdate())
    -
    case
        when dateadd(
            year,
            datediff(year, fec_nac, getdate()),
            fec_nac
        ) > getdate()
        then 1
        else 0
    end > 30;


select *
from vista_clientes_mayores_30
order by edad desc;
