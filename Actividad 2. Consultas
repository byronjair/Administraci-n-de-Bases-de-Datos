/* Seleccionar los clientes de diciembre de 2021 */
create view vista_clientes_diciembre_2021
as
select distinct
    c.id_cliente,
    cast(c.nombre as varchar(100)) as nombre,
    cast(c.apellido as varchar(100)) as apellido,
    f.fecha,
    year(f.fecha) as año
from cliente c
inner join factura f
    on c.id_cliente = f.id_cliente
where f.fecha >= '2021-12-01'
  and f.fecha < '2022-01-01';


select * 
from vista_clientes_diciembre_2021
order by fecha;
/*Qué compras han realizado los siguientes clientes */
/* Valentina Anastasia Huerta Corral*/
create view vista_compras_valentina
as
select
    cast(c.nombre as varchar(100)) + ' ' +
    cast(c.apellido as varchar(100)) as cliente,
    f.fecha,
    p.nombre as producto,
    d.cantidad,
    d.precio
from cliente c
inner join factura f
    on c.id_cliente = f.id_cliente
inner join detalle d
    on f.id_detalle = d.id_detalle
inner join producto p
    on d.id_producto = p.id_producto
where c.id_cliente = 2;

select * from vista_compras_valentina
order by fecha;
