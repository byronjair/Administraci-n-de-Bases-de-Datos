/* Seleccionar el producto que más ventas ha tenido*/
create view vista_producto_mas_vendido
as
select top 1
    p.id_producto,
    cast(p.nombre as varchar(100)) as producto,
    sum(d.cantidad) as total_vendido
from producto p
inner join detalle d
    on p.id_producto = d.id_producto
group by
    p.id_producto,
    cast(p.nombre as varchar(100))
order by sum(d.cantidad) desc;

select *from vista_producto_mas_vendido;

/*Qué producto tienen más cantidad en stock */

create view vista_producto_mayor_stock
as
select top 1
    id_producto,
    cast(nombre as varchar(100)) as producto,
    stock
from producto
order by stock desc;


select * from vista_producto_mayor_stock

/*Ordenar, de la más antigua a la más reciente, las compras que ha habido en la tienda */

create view vista_compras_tienda
as
select
    f.id_factura,
    cast(c.nombre as varchar(100)) + ' ' +
    cast(c.apellido as varchar(100)) as cliente,
    f.fecha,
    cast(p.nombre as varchar(100)) as producto,
    d.cantidad,
    d.precio
from factura f
inner join cliente c
    on f.id_cliente = c.id_cliente
inner join detalle d
    on f.id_detalle = d.id_detalle
inner join producto p
    on d.id_producto = p.id_producto;


select *from vista_compras_tienda
order by fecha asc;

