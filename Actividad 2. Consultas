 /* Selecciona a los clientes del año 2021 en base a la fecha de la factura */
create view vista_clientes_2021
as
select distinct
    c.id_cliente,
    cast(c.nombre as varchar(100)) as nombre,
    cast(c.apellido as varchar(100)) as apellido,
    year(f.fecha) as año
from cliente c
inner join factura f
    on c.id_cliente = f.id_cliente
where year(f.fecha) = 2021;

select * from vista_clientes_2021;

